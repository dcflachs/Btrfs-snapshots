<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "snapshots-btrfs">
<!ENTITY author      "dcflachs">
<!ENTITY version     "2026.10.18">
<!ENTITY launch      "Tools/Snapshots-Btrfs">
<!ENTITY packageVER  "&version;">
<!ENTITY packageMD5  "1df5928c21cc9ec4af5bda0a1f11e5da">
<!ENTITY packageName "&name;-package-&packageVER;">
<!ENTITY packagefile "&packageName;.txz">
<!ENTITY github      "dcflachs/Btrfs-snapshots">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/&github;/default/&name;.plg">
<!ENTITY packageURL  "https://github.com/&github;/releases/download/&version;/&packagefile;">
<!ENTITY pluginLOC   "/boot/config/plugins/&name;">
<!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         launch="&launch;"
         pluginURL="&pluginURL;"
         icon="fa-clone"
         min="6.8.0"
>

<CHANGES>
##Snapshots-Btrfs
###2026.10.18

  - Remove Browse Page in favor of using the built in Unraid File Browser.
  - Rework UI styling.
  - Fix long standing issue in prefix template.
  - Removed ZFS support, now only supports BTRFS.
  - Restructure repository.
  - Forked from Snapshots by simonfair.

###2026.05.12

  - Fix missing toggles on 7.2+

2023.07.16

  - Fix Nested subvol retention processing.

2023.07.01

  - Fix removing VMs from schedule.

2023.06.30b

  - Add Settings page and exclusion option from PR by primeval_god thanks.
  - Add Disable options for VM Actions.

2022.12.25

  - Fix Retention process for disks(root volumes).
  
2022.12.23

  - PHP8 Fixes.

2022.12.04

  - PHP8 Fixes.

2022.08.05

  - Add manual option to schedule.

2022.06.25

  - Fix count of snapshots to remove.
  
2022.06.17

  - Add Docker file folders hide switch and functions to hide docker folder.

2022.03.31

  - Fix Toggle slider position

2022.03.05

  - Add Toggle switch for showing root of drives.
  - Chg Hide Snapshots line if no snapshots 
  - Fix Create Snapshot for root dialog did not complete correctly due to invalid path even thou snapshot created.

2022.02.05

  - Add Show root for BTRFS Volume.

2022.01.16

  - Chg Error processing on GUI for Creates/Send 
  - Fix Create Directory if doesn't exist.

2021.12.27

  - Initial Beta Release.

</CHANGES>

<FILE Name="&pluginLOC;/subvol.cfg">
<INLINE>
<![CDATA[
]]>
</INLINE>
</FILE>

<FILE Name="&pluginLOC;/subvolsch.cfg">
<INLINE>
<![CDATA[
]]>
</INLINE>
</FILE>

<!--
The 'pre-install' script.
-->

<!--
Snapshots background start script.
-->
<FILE Name="/tmp/start_snapshots" Mode="0770">
<INLINE>
#!/bin/bash
# Copy configuration files to tmp file system.
&emhttpLOC;/scripts/copy_config.sh 2>/dev/null
</INLINE>
</FILE>

<!--
Get the plugin bundle.
-->
<FILE Name="&pluginLOC;/&packagefile;" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<!--
The 'post-updgrade' script.
-->
<FILE Run="/bin/bash">
<INLINE>
echo "Removing previous versons now upgrade has completed."
echo
# Remove old 'bundle' files.
rm -f $(ls &pluginLOC;/*.txz 2>/dev/null | grep -v '&version;')
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>

mkdir &pluginLOC; 2>/dev/null
mkdir &emhttpLOC; 2>/dev/null
mkdir -p /tmp/&name;/config 2>/dev/null

# Adjust plugin permissions.
chmod 755 -R &emhttpLOC; 2>/dev/null

# Fix permissions of executable files
chmod +x &emhttpLOC;/scripts/* &emhttpLOC;/event/*

# Copy Config to tmp 
at -M -f /tmp/start_snapshots now 2>/dev/null

echo 
echo "-----------------------------------------------------------"
echo " &name; has been installed."
echo " "
echo " Copyright 2016-2020, simonfair"
echo " Maintained by: &author;"
echo " Version: &version;"
echo ""
echo "-----------------------------------------------------------"
echo 
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>

# Remove installed packages
find "&pluginLOC;/packages/" -type f -iname "*.txz" -delete

rm -f /tmp/plugins/&name;.plg 
rm -r /tmp/&name;
rm  -f &pluginLOC;/*.cron 
update_cron

# Remove all plugin files from emhttp.
removepkg &pluginLOC;/&packagefile; 

echo 
echo "-----------------------------------------------------------"
echo " &name; has been uninstalled."
echo "-----------------------------------------------------------"
echo
</INLINE>
</FILE>

</PLUGIN>
